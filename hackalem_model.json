  "formula": {
    "indicator": "clip(initial + sum(effect * (8 - lag_quarters) / 8) + fixed_synergies, 0, 100)",
    "district_total": "sum(weight[k] * updated_indicator[d][k])",
    "city_mean": "sum(population_share[d] * district_total[d])",
    "critical_count": "count((d,k) where updated_indicator[d][k] < 40)",
    "score": "0.7 * city_mean + 0.3 * min(district_total.values()) - critical_count",
    "implementation_note": "Сложить все эффекты и синергии, затем clip ОДИН раз. Не округлять промежуточные результаты. Округление до двух знаков только для отображения."
  },
